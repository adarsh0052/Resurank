{
  "rewrites": [
    {
      "source": "/upload-resumes/",
      "destination": "/api/index.py"
    },
    {
      "source": "/job-categories/",
      "destination": "/api/index.py"
    },
    {
      "source": "/job-roles/:category",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|upload-resumes|job-categories|job-roles|assets|favicon.ico|logo.png|vite.svg).*)",
      "destination": "/index.html"
    }
  ]
}
